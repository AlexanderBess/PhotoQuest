# Local development configuration (PQ-003).
#
# Copy to backend/.env, which is git-ignored:
#   Copy-Item backend/.env.example backend/.env
#
# Every value below is a local-only placeholder, not a secret. Never put real
# credentials in this file or in backend/.env.
#
# Task loads backend/.env for every task; a variable already set in the shell
# takes precedence. docker compose reads it through `task deps:*`.

# --- API and worker (read now) ---------------------------------------------
PQ_ENV=local
PQ_HTTP_ADDR=127.0.0.1:8080
PQ_LOG_LEVEL=info
PQ_SHUTDOWN_TIMEOUT=10s

# --- PostgreSQL container (read by compose.yaml) ----------------------------
PQ_DB_PASSWORD=photoquest-local-only
PQ_DB_NAME=photoquest
PQ_DB_PORT=5432

# --- Local S3-compatible storage, provisional (read by compose.yaml) --------
PQ_S3_ACCESS_KEY_ID=photoquest-local
PQ_S3_SECRET_ACCESS_KEY=photoquest-local-only-secret
PQ_S3_BUCKET=photoquest-local
PQ_S3_PORT=8333

# --- Reserved: not read by any process yet ----------------------------------
# Keep them consistent with the values above if you change those.
# Database access (PQ-005):
PQ_DATABASE_URL=postgres://photoquest:photoquest-local-only@127.0.0.1:5432/photoquest?sslmode=disable
# Storage adapter (PQ-007):
PQ_S3_ENDPOINT=http://127.0.0.1:8333
